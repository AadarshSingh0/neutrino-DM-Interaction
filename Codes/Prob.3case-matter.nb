              RowBox[{"vertices", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "+", 
             RowBox[{
              RowBox[{"MulSMFinProb", "[", 
               RowBox[{"[", 
                RowBox[{"i2", ",", "p", ",", "1"}], "]"}], "]"}], "*", 
              RowBox[{"vertices", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "+", 
             RowBox[{
