Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "Step"}]}], " ", "1"}], ":", 
    RowBox[{
     RowBox[{"Order", " ", "the", " ", "Points", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Heuristic", ":", 
         RowBox[{"Sort", " ", "by", " ", "Angle"}]}], ")"}], "--"}]}], 
     "-"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"centroid", "=", 
     RowBox[{"Mean", "[", "dataPoints", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"angle", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"x", "-", 
        RowBox[{"centroid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"y", "-", 
        RowBox[{"centroid", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sortedPoints", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"dataPoints", ",", "angle"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"Create", " ", "an", " ", "OPEN", " ", "B"}], "-", 
      RowBox[{"Spline", " ", 
       RowBox[{"Function", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Do", " ", "NOT", " ", "append", " ", "the", " ", "first", " ", "point"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"SplineClosed", "->", 
     RowBox[{"False", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"or", " ", "omit"}], ",", 
        RowBox[{"as", " ", "False", " ", "is", " ", "default"}]}], ")"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"splineFuncOpen", "=", 
     RowBox[{"BSplineFunction", "[", 
      RowBox[{"sortedPoints", ",", 
       RowBox[{"SplineDegree", "->", "3"}], ",", 
       RowBox[{"SplineClosed", "->", "False"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "3"}], ":", 
     RowBox[{
      RowBox[{
      "Plot", " ", "the", " ", "OPEN", " ", "Spline", " ", "using", " ", 
       RowBox[{"ParametricPlot", "--"}]}], "-"}]}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Determine", " ", "the", " ", "parameter", " ", "range", " ", "for", " ", 
     "the", " ", "open", " ", "spline"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"It", "'"}], "s", " ", "often", " ", "related", " ", "to", " ", 
      "the", " ", "number", " ", "of", " ", "points"}], ",", 
     RowBox[{"check", " ", 
      RowBox[{"splineFuncOpen", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", "if", " ", "needed"}], ",", 
     RowBox[{"but", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}], " ", "often", " ", "works"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tmin", ",", "tmax"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Default", " ", "parameter", " ", "range", " ", "for", " ", 
     "BSplineFunction"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Check", " ", "if", " ", "the", " ", "function", " ", "provides", " ", 
     "its", " ", "own", " ", 
     RowBox[{"range", ":"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", 
         RowBox[{"splineFuncOpen", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "===", "List"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"splineFuncOpen", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}], "==", "1"}], "&&", 
       RowBox[{
        RowBox[{"Head", "[", 
         RowBox[{"splineFuncOpen", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "===", "List"}], "&&", 
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"splineFuncOpen", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], "]"}], "==", "2"}]}], ",", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tmin", ",", "tmax"}], "}"}], "=", 
       RowBox[{"splineFuncOpen", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "1"}], "]"}], "]"}]}]}], "]"}], "*)"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"plotSplineOpen", "=", 
     RowBox[{"ParametricPlot", "[", 
      RowBox[{
