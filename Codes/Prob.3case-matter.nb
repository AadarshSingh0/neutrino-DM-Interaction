Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "Get", " ", "Random", " ", "PMNS", " ", 
    "Parameters"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"getRandomPMNSParameters", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "th12Deg", ",", "th13Deg", ",", "th23Deg", ",", "dCPRad", ",", 
        "th12Rad", ",", "th13Rad", ",", "th23Rad", ",", "PSMMix", ",", 
        "dCPDeg"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"th12Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta12MinDeg", ",", "theta12MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Sample", " ", "parameters", " ", "uniformly", " ", "within", " ", 
          "its", " ", "3"}], "-", 
         RowBox[{"sigma", " ", "range"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"th13Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta13MinDeg", ",", "theta13MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"th23Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta23MinDeg", ",", "theta23MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dCPDeg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"deltaCPMinDeg", ",", "deltaCPMaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], "  ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"th12Rad", "=", 
        RowBox[{"th12Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"th13Rad", "=", 
        RowBox[{"th13Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"th23Rad", "=", 
        RowBox[{"th23Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"PSMMix", "=", 
        RowBox[{"SMMixProbmat", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Phi]12", "->", "th12Deg"}], ",", 
           RowBox[{"\[Phi]13", "->", "th13Deg"}], ",", 
           RowBox[{"\[Phi]23", "->", "th23Deg"}], ",", 
           RowBox[{"\[Delta]CP", "->", "dCPDeg"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{
         "th12Deg", ",", "th13Deg", ",", "th23Deg", ",", "dCPDeg", ",", 
          "PSMMix"}], "}"}], "]"}], ";"}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.95655121215152*^9, 3.956551216164646*^9}, {
