Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Custom", " ", "legend", " ", "with", " ", "markers"}], "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"legend", "=", 
     RowBox[{"PointLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Red", ",", "Gray", ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.10", ",", "0.75", ",", "0.75"}], "]"}], ",", "Green", 
         ",", 
         RowBox[{"RGBColor", "[", 
          RowBox[{"0.50", ",", "0.50", ",", "0.90"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
        "\"\<SM (1:2:0) Initial Ratio Evolution\>\"", ",", 
         "\"\<Uncertain SM (x:1-x:0) Initial Ratio Evolution\>\"", ",", 
         "\"\<(1:2:0) Initial Ratio\>\"", ",", 
         "\"\<Uncertain SM (1:2:0) Initial Ratio Evolution\>\"", ",", 
         "\"\<v-DM Mixing Evolution (1:2:0) Initial Ratio\>\""}], "}"}], ",", 
       
       RowBox[{"LegendMarkers", "->", 
        RowBox[{"{", 
         RowBox[{
         "\"\<\[FivePointedStar]\>\"", ",", "\"\<\[FilledDiamond]\>\"", ",", 
          "\"\<\[FilledUpTriangle]\>\"", ",", "\"\<\[FilledCircle]\>\"", ",", 
          "\"\<\[FilledCircle]\>\""}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{"Circle", ",", "diamond", ",", "triangle"}], "*)"}], 
       RowBox[{"LegendLayout", "->", "\"\<Column\>\""}]}], "]"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "the", " ", "plot", " ", "and", " ", "legend", " ", 
     "side", " ", "by", " ", "side"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Trib", "=", 
    RowBox[{"GraphicsRow", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Tri3", ",", "legend"}], "}"}], ",", 
      RowBox[{"Spacings", "->", "4"}]}], "]"}]}]}]}]], "Input",
