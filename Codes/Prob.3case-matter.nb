        "coordinates"}], "*)"}], "\n", 
      RowBox[{"i2", "=", "1"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"i2", "<", 
         RowBox[{"1", "+", 
          RowBox[{"Length", "[", "sampledParameterList", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"MulSMPoints", "[", 
