Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "filePath", "=", 
     "\"\<C:\\\\Users\\\\YourName\\\\Documents\\\\Mathematica\\\\contour_\
points.csv\>\""}], ";"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Option", " ", 
    RowBox[{"B", ":", 
     RowBox[{"Relative", " ", "Path", " ", 
      RowBox[{"(", 
       RowBox[{"if", " ", "the", " ", "CSV", " ", "is", " ", "in", " ", 
        RowBox[{"Mathematica", "'"}], "s", " ", "current", " ", "directory"}],
        ")"}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"filePath", "=", "\"\<contour_points.csv\>\""}], ";"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Option", " ", 
    RowBox[{"C", ":", 
     RowBox[{"Use", " ", "the", " ", "Menu", " ", 
      RowBox[{"(", 
       RowBox[{"Insert", "->", 
        RowBox[{
         RowBox[{"File", " ", "Path"}], "..."}]}], ")"}], " ", "and", " ", 
      "paste", " ", "the", " ", "result", " ", "here"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"filePath", "=", "\"\</home/as/Default Dataset.csv\>\""}], ";"}], 
   "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Step"}]}], " ", "2"}], ":", 
     RowBox[{
      RowBox[{"Import", " ", "the", " ", 
       RowBox[{"Data", "--"}]}], "-"}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Use", " ", "Import", " ", "with", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<CSV\>\"", ",", "\"\<Data\>\""}], "}"}]}], "-", 
     RowBox[{
     "this", " ", "is", " ", "usually", " ", "robust", " ", "and", " ", 
      "handles", " ", "headers"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "It", " ", "attempts", " ", "to", " ", "interpret", " ", "columns", " ", 
     "as", " ", "numeric", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataPoints", "=", 
     RowBox[{"Import", "[", 
      RowBox[{"filePath", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<CSV\>\"", ",", "\"\<Data\>\""}], "}"}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "centroid", " ", 
     RowBox[{"(", 
      RowBox[{"average", " ", "point"}], ")"}]}], "*)"}], 
   RowBox[{
    RowBox[{"centroid", "=", 
     RowBox[{"Mean", "[", "dataPoints", "]"}]}], ";"}], "\[IndentingNewLine]",
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "a", " ", "function", " ", "to", " ", "get", " ", "the", 
     " ", "angle", " ", "relative", " ", "to", " ", "the", " ", "centroid"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"ArcTan", "[", 
       RowBox[{"x", ",", "y"}], "]"}], " ", "gives", " ", "angle", " ", "in", 
      " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "Pi"}], ",", "Pi"}]}]}], "]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"angle", "[", 
      RowBox[{"{", 
       RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
     RowBox[{"ArcTan", "[", 
      RowBox[{
       RowBox[{"x", "-", 
        RowBox[{"centroid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"y", "-", 
        RowBox[{"centroid", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Sort", " ", "the", " ", "data", " ", "points", " ", "by", " ", "angle"}],
     "*)"}], "\n", 
   RowBox[{
    RowBox[{"sortedPoints", "=", 
     RowBox[{"SortBy", "[", 
      RowBox[{"dataPoints", ",", "angle"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Close", " ", "the", " ", "loop"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"closedSortedPoints", "=", 
     RowBox[{"Append", "[", 
      RowBox[{"sortedPoints", ",", 
       RowBox[{"First", "[", "sortedPoints", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Plot", " ", "the", " ", "sorted", " ", "points", " ", "connected", " ", 
     "by", " ", "lines"}], "*)"}], "\n", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"closedSortedPoints", ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Blue"}], "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", "\"\<Points Sorted by Angle and Connected\>\""}], ",", 
     RowBox[{"GridLines", "->", "Automatic"}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"FontSize", "->", "12"}]}], ",", 
     RowBox[{"ImageSize", "->", "Medium"}]}], 
    RowBox[{"(*", 
     RowBox[{"Show", " ", "original", " ", "points"}], "*)"}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9530810407726297`*^9, 3.9530810407730017`*^9}, {
   3.9530812543827753`*^9, 3.953081272565917*^9}, {3.9530815854028873`*^9, 
