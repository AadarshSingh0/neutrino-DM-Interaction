Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "vertices", " ", "of", " ", "the", " ", 
    "flavor", " ", "triangle"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"vertices", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "triangle", " ", "region", " ", "for", " ", 
     "clipping"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"triangleRegion", "=", 
     RowBox[{"Polygon", "[", "vertices", "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "labels", " ", "for", " ", "the", " ", 
     "vertices"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"labels", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(\[Mu]\\)]\\)\>\"", ",", 
       "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(\[Tau]\\)]\\)\>\"", ",", 
       "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(e\\)]\\)\>\""}], "}"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
