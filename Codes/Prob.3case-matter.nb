Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "vertices", " ", "of", " ", "the", " ", 
    "flavor", " ", "triangle"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"vertices", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0.5", ",", 
         RowBox[{
          RowBox[{"Sqrt", "[", "3", "]"}], "/", "2"}]}], "}"}]}], "}"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "triangle", " ", "region", " ", "for", " ", 
     "clipping"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"triangleRegion", "=", 
     RowBox[{"Polygon", "[", "vertices", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "labels", " ", "for", " ", "the", " ", 
     "vertices"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"labels", "=", 
     RowBox[{"{", 
      RowBox[{
      "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(e\\)]\\)\>\"", ",", 
       "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(\[Mu]\\)]\\)\>\"", ",", 
       "\"\<\\!\\(\\*SubscriptBox[\\(\[Nu]\\), \\(\[Tau]\\)]\\)\>\""}], 
      "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "the", " ", "probabilities", " ", "for", " ", "each", " ", 
     "flavor"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilities", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"prob", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", 
       RowBox[{"prob", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"prob", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"f\[Tau]", ",", " ", "fe", ",", " ", "f\[Mu]"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"probabilities2", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"probSM", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], ",", 
       RowBox[{"probSM", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"probSM", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"f\[Tau]", ",", " ", "fe", ",", " ", "f\[Mu]"}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "probabilities", " ", "to", " ", "Cartesian", " ", 
     "coordinates"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"point", "=", 
     RowBox[{
