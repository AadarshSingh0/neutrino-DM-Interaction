Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Function", " ", "to", " ", "Get", " ", "Random", " ", "SM", " ", 
    RowBox[{"Ratio", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"getRandomSMPointsVaryInit", "[", "InitRatio_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "th12Deg", ",", "th13Deg", ",", "th23Deg", ",", "dCPRad", ",", 
        "th12Rad", ",", "th13Rad", ",", "th23Rad", ",", "PSMMix", ",", 
        "dCPDeg", ",", "FinSMRatio", ",", "SMFinProb", ",", "SMPoints", ",", 
        "ProbInitRatio", ",", "PointInitRatio"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"th12Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta12MinDeg", ",", "theta12MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Sample", " ", "parameters", " ", "uniformly", " ", "within", " ", 
          "its", " ", "3"}], "-", 
         RowBox[{"sigma", " ", "range"}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"th13Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta13MinDeg", ",", "theta13MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"th23Deg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"theta23MinDeg", ",", "theta23MaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], " ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dCPDeg", "=", 
        RowBox[{
         RowBox[{"RandomReal", "[", 
          RowBox[{"{", 
           RowBox[{"deltaCPMinDeg", ",", "deltaCPMaxDeg"}], "}"}], "]"}], "*", 
         RowBox[{"180", "/", "\[Pi]"}], "  ", "Degree"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"th12Rad", "=", 
        RowBox[{"th12Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"th13Rad", "=", 
        RowBox[{"th13Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"th23Rad", "=", 
        RowBox[{"th23Deg", "*", 
         RowBox[{"(", 
          RowBox[{"Pi", "/", "180"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"PSMMix", "=", 
        RowBox[{"SMMixProbmat", "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Phi]12", "->", "th12Deg"}], ",", 
           RowBox[{"\[Phi]13", "->", "th13Deg"}], ",", 
           RowBox[{"\[Phi]23", "->", "th23Deg"}], ",", 
           RowBox[{"\[Delta]CP", "->", "dCPDeg"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"FinSMRatio", "=", 
        RowBox[{
         RowBox[{"Transpose", "[", "PSMMix", "]"}], ".", "InitRatio"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"SMFinProb", " ", "=", " ", 
        RowBox[{"FinSMRatio", "/", 
         RowBox[{"(", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"FinSMRatio", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ")"}]}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"SMPoints", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"SMFinProb", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"SMFinProb", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"SMFinProb", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ProbInitRatio", " ", "=", " ", 
        RowBox[{"InitRatio", "/", 
         RowBox[{"(", 
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"InitRatio", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "3"}], "}"}]}], "]"}], ")"}]}]}], 
       ";", " ", 
       RowBox[{"(*", 
        RowBox[{"Initial", " ", "flavour", " ", 
         RowBox[{"probability", "."}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"PointInitRatio", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"ProbInitRatio", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"ProbInitRatio", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"ProbInitRatio", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "*", 
          RowBox[{"vertices", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}]}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"{", 
         RowBox[{"SMPoints", ",", "PointInitRatio"}], "}"}], "]"}], ";"}]}], 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.956711330147814*^9, 3.9567113320874*^9}, {
