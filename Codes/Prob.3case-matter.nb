    "Define", " ", "the", " ", "probabilities", " ", "for", " ", "each", " ", 
     "flavor"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"probabilities", "=", 
     RowBox[{"{", 
      RowBox[{"0.5", ",", "0.3", ",", "0.2"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"probabilities2", "=", 
